// demonshot: ascii-D (та же D, что на картах), подпись shot·trick, строка arcana — карта дня
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/sigil.txt",
        "color": { "1": "38;2;199;48;61" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;122;104;112",
            "title": "38;2;233;223;221",
            "output": "38;2;233;223;221"
        },
        "percent": { "color": { "green": "38;2;184;72;122", "yellow": "38;2;184;72;122", "red": "38;2;199;48;61" } }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;184;72;122mshot·trick"
        },
        "break",
        { "type": "os", "key": "os    ", "format": "{pretty-name}" },
        { "type": "kernel", "key": "kern  ", "format": "{release}" },
        { "type": "wm", "key": "wm    ", "format": "{pretty-name}" },
        { "type": "shell", "key": "shell ", "format": "{pretty-name}" },
        { "type": "uptime", "key": "up    " },
        { "type": "memory", "key": "mem   " },
        { "type": "packages", "key": "pkgs  ", "format": "{all}" },
        {
            "type": "command",
            "key": "arcana",
            // карта дня: день года mod 22, как на локе
            "text": "date +%-j | awk '{split(\"The Fool,The Magician,The Priestess,The Empress,The Emperor,The Hierophant,The Lovers,The Chariot,Strength,The Hermit,The Wheel,Justice,The Hanged Man,Death,Temperance,The Devil,The Tower,The Star,The Moon,The Sun,Judgement,The World\",a,\",\"); print a[$1%22+1]}'",
            "format": "\u001b[38;2;184;72;122m{}"
        },
        "break"
    ]
}
